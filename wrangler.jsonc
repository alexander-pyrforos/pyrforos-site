{
  "name": "pyrforos-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pyrforos-votes",
      "database_id": "6ce14b08-3fa1-41a3-91f6-accdc7d32d98"
    }
  ],
  // Local dev secret value lives in .dev.vars (git-ignored); production uses
  // `wrangler secret put VOTE_SALT` — a var here would collide with the secret.
  "routes": [
    { "pattern": "pyrforos.xyz", "custom_domain": true },
    { "pattern": "www.pyrforos.xyz", "custom_domain": true }
  ]
}